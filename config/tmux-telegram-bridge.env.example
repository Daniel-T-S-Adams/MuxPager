# Create a private bot with @BotFather and put its token here. Never commit the
# real token to this repository.
TMUX_TELEGRAM_BOT_TOKEN=

# Leave empty for the first start. Message the bot /id, copy the returned user
# ID here, then restart the service. Pairing mode never exposes tmux data.
TMUX_TELEGRAM_ALLOWED_USER_ID=

# Post a fresh message in the agent's topic when it finishes a turn.
TMUX_TELEGRAM_NOTIFY=1
TMUX_TELEGRAM_POLL_TIMEOUT=5

# Keep a topic open through brief agent restarts. Once an agent has been absent
# for this many seconds, close (but do not delete) its topic.
TMUX_TELEGRAM_CLOSE_AFTER=60
