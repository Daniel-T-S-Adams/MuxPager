[Unit]
Description=MuxPager Telegram topics
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
EnvironmentFile=%h/.config/tmux-telegram-bridge/env
ExecStart=%h/.local/bin/tmux-telegram-bridge
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateDevices=true
ProtectClock=true
ProtectControlGroups=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true

[Install]
WantedBy=default.target
